<%= render Admin::TableActionsComponent.new(
  document,
  actions: [:destroy],
  destroy_path: admin_site_customization_document_path(document),
  html_options: { class: "site-customization-documents-table-actions" }
) do |actions| %>
  <%= actions.action(:download,
                     text: t("documents.buttons.download_document"),
                     path: permanent_document_url(only_path: true),
                     rel: "nofollow") %>
  <%= actions.action(:copy_link,
                     text: t("shared.actions.copy_link"),
                     button_tag: true,
                     data: { url: permanent_document_url }) %>
<% end %>
